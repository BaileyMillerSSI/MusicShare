{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://breadsticklabs.com/contracts/status-v2.schema.json",
  "title": "Authenticated app status v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "service",
    "environment",
    "build",
    "deployment",
    "health",
    "sampledAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "service": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "version",
        "builtAt"
      ],
      "properties": {
        "sha": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}(?![\\s\\S])"
            }
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
            }
          ]
        },
        "builtAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z(?![\\s\\S])"
            }
          ]
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "url"
          ],
          "properties": {
            "runId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,31}(?![\\s\\S])"
            },
            "url": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}/actions/runs/[1-9][0-9]{0,31}(?![\\s\\S])"
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deployedAt"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
            }
          ]
        },
        "deployedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z(?![\\s\\S])"
            }
          ]
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "coverage",
        "components"
      ],
      "properties": {
        "state": {
          "enum": [
            "healthy",
            "degraded",
            "unknown"
          ]
        },
        "coverage": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
          }
        },
        "components": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "state"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
              },
              "state": {
                "enum": [
                  "healthy",
                  "degraded",
                  "unknown"
                ]
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": false,
      "patternProperties": {
        "^[_a-zA-Z][_a-zA-Z0-9]{0,63}(?![\\s\\S])": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sampledAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,3})?Z(?![\\s\\S])"
    }
  }
}
