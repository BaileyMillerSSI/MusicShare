{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "InternalApi": {
    "ApiKey": "",
    "HeaderName": "X-Internal-API-Key"
  },
  "MongoDB": {
    "DatabaseName": "musicshare"
  },
  "Spotify": {
    "ClientId": "<your-spotify-client-id>",
    "ClientSecret": "<your-spotify-client-secret>",
    "ConfidenceThreshold": 0.80
  },
  "YouTubeMusic": {
    "GeographicLocation": "US",
    "ConfidenceThreshold": 0.67
  }
}
